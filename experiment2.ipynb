   "source": [
    "#convert celsius to fahrenhit\n",
    "c=float(input(\"enter celsius: \"))\n",
    "f=c*9/5+32\n",
    "print(\"fahrenheit {f}F\")\n",
    "km=float(input(\"eneter km: \"))\n",
    "m=km*0.62137\n",
    "print(round(m,2),\" miles\")\n"
   ]
